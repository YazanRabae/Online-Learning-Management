@{
    ViewData["Title"] = "Home Page";
    ViewBag.showSidebar = false;
}
<link href="~/css/views/home/index.css" rel="stylesheet" />

<div class="container">
    <div class="text-center">
        <h1 class="hero-title">E-learning Management System</h1>
    </div>

    <!-- Carousel -->
    <div id="carouselExampleCaptions" class="carousel slide mb-5 mt-4" data-bs-ride="carousel" data-bs-interval="5000">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active"
                    aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1"
                    aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2"
                    aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/photo/AdobeStock_197062338.png" class="d-block w-100" alt="Interactive Learning">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Interactive Learning</h5>
                    <p>Access to courses, videos, quizzes, and discussions online.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/photo/960x0.png" class="d-block w-100" alt="Flexible Scheduling">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Flexible Scheduling</h5>
                    <p>Learn at your own pace, anytime, anywhere.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/photo/cover_hu3d03a01dcc18bc5be0e67db3d8d209a6_184197_1280x0_resize_q90_h2_lanczos.fb14c134342d2bea0403db653637a3ce725f63e353d3537016bf81f05e1367bb.png"
                     class="d-block w-100" alt="Centralized Resources">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Centralized Resources</h5>
                    <p>Manage materials and track progress efficiently.</p>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions"
                data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions"
                data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

   <!-- Login Card -->
    <div class="d-flex justify-content-center mb-5">
        <div class="col-lg-8">
            <div class="user-card">
                <i class="bi bi-person-circle user-icon"></i>
                <h2>Welcome to LMS</h2>
                <p>Please log in to continue and explore your learning journey.</p>
                @if (User.Identity.IsAuthenticated)
                {
                    <button class="btn btn-light fw-semibold shadow-sm" disabled>
                        <i class="bi bi-box-arrow-in-right me-2"></i> Logged In
                    </button>
                }
                else
                {
                    <a asp-controller="Home" asp-action="LogIn" class="btn btn-light fw-semibold shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Log In
                    </a>
                }
            </div>
        </div>
    </div>
</div>
 
