@{
    ViewData["Title"] = "Student";
}
<script src="~/js/views/admin/students.js"></script>
<div class="container">

    <h1 class="text-left">@ViewData["Title"]</h1>
    <div>
        <a type="button" asp-action="CreateUser" asp-controller="Admin" asp-route-roleName="@RoleConstants.Student" class="btn btn-primary">Create Student</a>
    </div>
    <br />
    <div class="col">
        <div class="card p-4">
            <h4>Search by</h4>
            <form id="searchForm" action="#" method="post" class="php-email-form">
                <div class="row gy-4">

                    <div class="col-md-3">
                        <input type="text" id="filterName" name="name" class="form-control" placeholder="Name" >
                    </div>

                    <div class="col-md-3">
                        <input type="email" id="filterEmail" class="form-control" name="email" placeholder="Email" >
                    </div>

                    <div class="col-md-3 text-center">
                        <button type="button" class="btn btn-primary" id="applyFilters">Search</button> | <button type="button" class="btn btn-default" id="restFilters">Rest</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <section class="section">
        <div class="d-flex justify-content-center">
            <div class="col-lg-12">

                <div class="card p-4">
                    <div class="card-body">
                        <!-- Table with striped rows -->
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Email</th>
                                </tr>
                            </thead>
                            <tbody id="StudentsTableBody">
                          
                            </tbody>
                        </table>
                        <!-- End Table with striped rows -->

                    </div>
                </div>

            </div>
        </div>
    </section>
</div>
<input type="hidden" id="pageNumber" />
<div class="d-flex justify-content-end mt-3 gap-2">
    <a class="btn btn-outline-primary" id="previousPage">Previous</a>
    <a class="btn btn-outline-primary" id="nextPage">Next</a>
</div>

<script>
    $(document).ready(function () {
        GetStudents.onStart();
    });
</script>
