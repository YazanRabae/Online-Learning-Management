@{
    ViewData["Title"] = "Courses";
}

<script src="~/js/views/admin/courses.js"></script>
<link href="~/css/views/admin/courses.css" rel="stylesheet" />

<div class="container">
    <h1 class="text-left">@ViewData["Title"]</h1>

    <div class="col mb-4">
        <div class="card p-4">
            <h4>Search by</h4>
            <div class="row gy-4">
                <div class="col-md-3">
                    <input type="text" name="courseName" id="courseName" class="form-control" placeholder="Course Title">
                </div>
                <div class="col-md-3">
                    <select name="instructorEmail" id="instructorEmail" aria-label="Instructor Name">
                        <option value="" selected disabled hidden>Select Instructor</option>
                    </select>
                </div>
                <div class="col-md-3 text-center">
                    <button type="button" id="searchButton" class="btn btn-primary">Search</button> | <button type="button" class="btn btn-default" id="restFilters">Rest</button>
                </div>
            </div>
        </div>
    </div>

    <section class="section">
        <div class="d-flex justify-content-center">
            <div class="col-lg-12">
                <div class="card p-4">
                    <div class="card-body" id="table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Title</th>
                                    <th>Instructor</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Max Students</th>
                                    <th>Price</th>
                                    <th>Course Time (hrs)</th>
                                    <th>Description</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="courseTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Students Modal -->
<div class="modal fade" id="studentsModal" tabindex="-1" role="dialog" aria-labelledby="studentsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Enrolled Students</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul id="studentsList" class="list-group"></ul>
            </div>
        </div>
    </div>
</div>

<!-- Description Modal -->
<div class="modal fade" id="descriptionModal" tabindex="-1" role="dialog" aria-labelledby="descriptionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Course Description</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="descriptionModalBody"></div>
        </div>
    </div>
</div>
<input type="hidden" id="pageNumber" />
<div class="d-flex justify-content-end mt-3 gap-2">
    <a class="btn btn-outline-primary" id="previousPage">Previous</a>
    <a class="btn btn-outline-primary" id="nextPage">Next</a>
</div>
