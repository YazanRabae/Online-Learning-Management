 @model LMS.Service.DTOs.Students.CreateUserDto

@{
    ViewData["Title"] = "Add " + Model.RoleName;
}

<div class="container mt-5">
    <h1 class="text-left">Create a New @Model.RoleName</h1>
    <br />
    <div class="card shadow-lg border-0">
        <div class="card-header bg-secondary text-white text-center">
            <h3>Course Details</h3>
        </div>
        <div class="card-body p-4">
            <form asp-action="CreateUser" method="POST" enctype="multipart/form-data">
                <div class="row">
                    <input asp-for="RoleName" type="hidden">
                    <!-- Left Column -->
                    <div class="col-md-6">
                        <div class="form-group mb-4">
                            <label for="Name" class="form-label">@Model.RoleName Name</label>
                            <input asp-for="Name" type="text" class="form-control" id="Name" name="Name" placeholder="Enter @Model.RoleName Name" required>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label for="Email" class="form-label">@Model.RoleName Email</label>
                            <input asp-for="Email" type="email" class="form-control" id="Email" name="Email" placeholder="Enter @Model.RoleName Email" required>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">
                        <div class="form-group mb-4">
                            <label for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control" value="@TempData["Password"]" name="Password" placeholder="Password" required>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label for="ConfirmPassword" class="form-label">ConfirmPassword</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" value="@TempData["ConfirmPassword"]" name="ConfirmPassword" placeholder="Confirm Password" required>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-secondary btn-lg px-5">Create @Model.RoleName</button>
                </div>
            </form>
        </div>
    </div>
</div>