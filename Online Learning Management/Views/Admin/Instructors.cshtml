@{
    ViewData["Title"] = "Instructor";
}
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/js/views/admin/instructors.js"></script>
<div class="container">
    <h1 class="text-left">@ViewData["Title"]</h1>
    <div>
        <a type="button" asp-action="CreateUser" asp-controller="Admin" asp-route-roleName="@RoleConstants.Instructor" class="btn btn-primary">Create Instructor</a>
    </div>
    
    <br />
    <div class="col">
        <div class="card p-4">
            <h4>Search by</h4>
            <form id="searchForm" action="#" method="post" class="php-email-form">
                <div class="row gy-4">

                    <div class="col-md-3">
                        <input type="text"  name="name" class="form-control" placeholder="Name" id="filterUserName">
                    </div>

                    <div class="col-md-3">
                        <input type="email" class="form-control" name="email" placeholder="Email" id="filterEmail">
                    </div>

                    <div class="col-md-3 text-center">
                        <button type="button" class="btn btn-primary" id="applyFilters">Search</button> | <button type="button" class="btn btn-default" id="restFilters">Rest</button>
                    </div>

                </div>
            </form>
        </div>
    </div>
    <section class="section">
        <div class="d-flex justify-content-center">
            <div class="col-lg-12">

                <div class="card p-4">
                    <div class="card-body">
                        <!-- Table with striped rows -->
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Email</th>
                                </tr>
                            </thead>
                            <tbody id="InstructorsTableBody">
                        
                            </tbody>
                        </table>
                        <!-- End Table with striped rows -->

                    </div>
                </div>

            </div>
        </div>
    </section>
</div>
<script>
    $(document).ready(function () {
        GetInstructors.OnStart();
    });
</script>