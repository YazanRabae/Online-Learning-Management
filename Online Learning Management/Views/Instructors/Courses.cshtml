@{
    ViewData["Title"] = "Courses";
}
<script src="~/js/views/instructors/courses.js"></script>

<section class="section dashboard">
    <div class="container">
        <div class="row align-items-center mb-3">
            <div class="col">
                <h1>Courses</h1>
            </div>
            <div>
                <a class="btn btn-primary" asp-controller="Instructors" asp-action="AddCourses">Create Course</a>
            </div>
        </div>
        <div class="col">
            <div class="card p-4">
                <h4>Search by</h4>
                <form id="searchForm" action="#" method="post" class="php-email-form">
                    <div class="row gy-4">
                        <div class="col-md-3">
                            <label for="searchTitle" class="form-label">Course Title</label>
                            <input type="text" id="searchTitle" class="form-control" placeholder="Search by Title">
                        </div>
                        <div class="col-md-3">
                            <label for="startDateRange" class="form-label">Start Date Range</label>
                            <input type="text" id="startDateRange" class="form-control" placeholder="Enter Start Date Range" />
                        </div>
                        <div class="col-md-3">
                            <label for="endDateRange" class="form-label">End Date Range</label>
                            <input type="text" id="endDateRange" class="form-control" placeholder="Enter End Date Range" />
                        </div>
                        <div class="col-md-3 text-center" style="margin-top: auto">
                            <button type="button" id="btnSearch" class="btn btn-primary">Search</button> | <button type="button" id="btnReset" class="btn btn-default">Reset</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        
        <!-- 📋 Courses Table -->
        <div class="card p-3 shadow-sm">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Title</th>
                        <th scope="col">Instructor</th>
                        <th scope="col">Start Date</th>
                        <th scope="col">End Date</th>
                        <th scope="col">Max Students</th>
                        <th scope="col">Price</th>
                        <th scope="col">Course Time (hrs)</th>
                        <th scope="col">Description</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody id="courseInsTableBody"></tbody>
            </table>
        </div>
    </div>
</section>

<!-- 📘 Course Description Modal -->
<div class="modal fade" id="descriptionModal" tabindex="-1" aria-labelledby="descriptionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Course Description</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="descriptionModalBody">
                <!-- Full description will be inserted here -->
            </div>
        </div>
    </div>
</div>

<!-- 👥 Students Modal -->
<div class="modal fade" id="studentsModal" tabindex="-1" role="dialog" aria-labelledby="studentsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Enrolled Students</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul id="studentsList" class="list-group"></ul>
            </div>
        </div>
    </div>
</div>


<input type="hidden" id="pageNumber" />
<div class="d-flex justify-content-end mt-3 gap-2">
    <a class="btn btn-outline-primary" id="previousPage">Previous</a>
    <a class="btn btn-outline-primary" id="nextPage">Next</a>
</div>

<script>
    $(document).ready(function () {
        GetCoursesIns.OnStart();
    });
</script>