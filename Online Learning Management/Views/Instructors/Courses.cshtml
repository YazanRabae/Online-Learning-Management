            <div class="col">
                <h1>My Courses</h1>
            </div>
            <div class="col-auto">
                <a class="btn btn-primary" asp-controller="Instructors" asp-action="AddCourses">Create Course</a>
            </div>

            <div class="card mt-4 p-3">
                <table class="table table-striped">
                    <thead>
