
<script src="~/js/views/instructors/enrollments.js"></script>
<section class="section dashboard">
    <div class="container">
        <div class="row align-items-center">
            <div class="col">
                <h1>Enrollments</h1>
            </div>
        </div>
        <div class="col">
            <div class="card p-4">
                <h4>Search by</h4>
                <form id="searchForm" action="#" method="post" class="php-email-form">
                    <div class="row gy-4">

                        <div class="col-md-3">
                            <input type="text" id="courseNameFilter" name="name" class="form-control" placeholder="Course Name">
                        </div>

                        <div class="col-md-3">
                            <input type="text" id="studentNameFilter" name="name" class="form-control" placeholder="Student Name">
                        </div>

                        <div class="col-md-3 text-center">
                            <button type="button" class="btn btn-primary" id="applyFilters">Search</button> | <button type="button" class="btn btn-default" id="restFilters">Rest</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="card mt-4 p-3">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Student Name</th>
                        <th scope="col">Course Name</th>
                        <th scope="col">Enrollment Date</th>
                        <th scope="col">Price</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody id="enrollmentTableBody">
                </tbody>
            </table>
        </div>
    </div>
</section>

<input type="hidden" id="pageNumber" />
<div class="d-flex justify-content-end mt-3 gap-2">
    <a class="btn btn-outline-primary" id="previousPage">Previous</a>
    <a class="btn btn-outline-primary" id="nextPage">Next</a>
</div>
<div class="d-flex justify-content-end mt-1 gap-2">
    <div class="pagnationStyle" id="divPageNumber">Page Number: </div>
    <div class="pagnationStyle" id="totalPage">Total Pages: </div>
</div>
<script>
    $(document).ready(function () {
        GetEnrollments.OnStart();
    });
</script>