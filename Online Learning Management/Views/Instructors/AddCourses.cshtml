 @model LMS.Service.DTOs.Courses.CourseDTO

@{
    if(Model == null || Model.Id == 0)
        ViewData["Title"] = "Add Course";
    else
        ViewData["Title"] = "Update Course";
}

<div class="container">
    @if (Model == null || Model.Id == 0)
    {
        <h1 class="text-left">Create a New Course</h1>
    }
    else
    {
        <h1 class="text-left">Update Course</h1>
    }
    <div class="col-auto">
        <a class="btn btn-secondary ml-2" asp-controller="Instructors" asp-action="Courses">
            <i class="fas fa-arrow-left"></i> Back To Courses
        </a>
    </div>
    <br />
    <div class="card shadow-lg border-0">
        <div class="card-header bg-secondary text-white text-center">
            <h3>Course Details</h3>
        </div>
        <div class="card-body p-4">
            <form asp-action="AddCourses" method="POST" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input id="inputId" asp-for="Id" value="@(Model?.Id ?? 0)" type="hidden"/>
                <input asp-for="InstructorId" value="@(Model?.InstructorId ?? 0)" type="hidden">
                <input asp-for="ExistingFile" value="@(Model?.ExistingFile ?? null)" type="hidden">
                <input asp-for="ImageName" value="@(Model?.ImageName ?? null)" type="hidden">
                <div class="row">
                    <!-- Left Column -->
                    <div class="col-md-6">
                        <div class="form-group mb-4">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" placeholder="Enter course title" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="CourseTime" class="form-label"></label>
                            <input asp-for="CourseTime" class="form-control" placeholder="Enter course duration" />
                            <span asp-validation-for="CourseTime" class="text-danger"></span>
                        </div>


                        <div class="form-group mb-4">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" class="form-control"
                                   data-val="true"
                                   data-val-datenotinpast="Start date cannot be in the past." />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" class="form-control"
                                   data-val="true"
                                   data-val-dategreaterthan="End date must be after the start date."
                                   data-val-dategreaterthan-otherproperty="StartDate" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" class="form-control" placeholder="Enter course price" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">
                        <div class="form-group mb-4">
                            <label asp-for="MaxStudents" class="form-label"></label>
                            <input asp-for="MaxStudents" class="form-control" placeholder="Enter max number of students" />
                            <span asp-validation-for="MaxStudents" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <div class="form-group mb-4">
                                <label class="form-label d-block">Course Image</label>
                                <div class="d-flex align-items-center gap-3">
                                    <input asp-for="ImageFile" id="ImageFileInput" class="form-control" accept="image/*"
                                           onchange="previewSelectedImage(this)"
                                           data-val="true"
                                           data-val-filerequired="Upload an image for the course (JPEG, PNG, etc.)."
                                           style="flex: 1;" />

                                    <img id="previewImage"
                                         src="data:image/jpeg;base64,@Model?.ExistingFile"
                                         alt="Current image"
                                         style="height: 60px; width: auto; border-radius: 4px;" />
                                </div>
                                <span asp-validation-for="ImageFile" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter course description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4">
                    @if (Model == null || Model.Id == 0)
                    {
                        <button type="submit" class="btn btn-secondary btn-lg px-5">Create Course</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-secondary btn-lg px-5">Update Course</button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/views/instructors/addcourses.js"></script>

}
<script>
    $(document).ready(function () {
        OnStart();
    });
</script>