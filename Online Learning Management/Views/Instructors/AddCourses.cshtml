@model LMS.Service.DTOs.Courses.CourseDTO

@{
    ViewData["Title"] = "Add Course";
}

<div class="container mt-5">
    <h1 class="text-left">Create a New Course</h1>
    <div class="col-auto">
        <a class="btn btn-secondary ml-2" asp-controller="Instructors" asp-action="Courses">
            <i class="fas fa-arrow-left"></i> Back To Courses
        </a>
    </div>
    <br />
    <div class="card shadow-lg border-0">
        <div class="card-header bg-secondary text-white text-center">
            <h3>Course Details</h3>
        </div>
        <div class="card-body p-4">
            <form asp-action="AddCourses" method="POST" enctype="multipart/form-data">
                @* Validation summary *@
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <!-- Left Column -->
                    <div class="col-md-6">
                        <div class="form-group mb-4">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" placeholder="Enter course title" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="CourseTime" class="form-label"></label>
                            <input asp-for="CourseTime" class="form-control" placeholder="Enter course duration" />
                            <span asp-validation-for="CourseTime" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" class="form-control" placeholder="Enter course price" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">
                        <div class="form-group mb-4">
                            <label asp-for="MaxStudents" class="form-label"></label>
                            <input asp-for="MaxStudents" class="form-control" placeholder="Enter max number of students" />
                            <span asp-validation-for="MaxStudents" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="ImageFile" class="form-label"></label>
                            <input asp-for="ImageFile" class="form-control" accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                            <small class="form-text text-muted">Upload an image for the course (JPEG, PNG, etc.).</small>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter course description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-secondary btn-lg px-5">Create Course</button>
                </div>
            </form>
        </div>
    </div>
</div>


