@model LMS.Service.DTOs.UserDTOs.RegisterDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Instructor Register - Transpo.Jo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(to right, #ffffff, #cce5ff);
            padding: 20px;
            margin: 0;
        }

        .register-container {
            width: 100%;
            max-width: 1200px;
            min-height: 600px;
            display: flex;
            background: #ffffff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        }

        .left-panel {
            flex: 1;
            background-color: #007bff;
            padding: 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            color: white;
        }

        .logo {
            margin-top: 75px;
            max-width: 250px;
            height: auto;
        }

        .logo-text {
            color: white;
            font-size: 1.5rem;
            margin-top: 1rem;
        }

        .footer {
            width: 100%;
            display: flex;
            justify-content: center;
            gap: 10px;
            color: white;
            font-size: 0.9rem;
            margin-top: auto;
        }

            .footer a {
                color: white;
                text-decoration: underline;
            }

                .footer a:hover {
                    text-decoration: none;
                }

        .right-panel {
            flex: 1;
            padding: 60px 40px;
            background-color: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            border-left: 2px solid #007bff;
        }

        .register-form {
            width: 100%;
            max-width: 400px;
            margin: 0 auto;
            background-color: #f8f9fa;
            padding: 30px;
            border-radius: 10px;
            border: 1px solid #dee2e6;
        }

        .form-label {
            color: #0056b3;
            font-size: 1.1rem;
            margin-bottom: 8px;
        }

        .form-control {
            padding: 12px 20px;
            border: 1px solid #ced4da;
            border-radius: 25px;
            margin-bottom: 1.5rem;
        }

            .form-control:focus {
                border-color: #007bff;
                box-shadow: 0 0 8px rgba(0, 123, 255, 0.4);
            }

        .btn-custom {
            width: 100%;
            padding: 12px 20px;
            background-color: #007bff;
            border: none;
            border-radius: 25px;
            color: white;
            font-weight: bold;
            transition: all 0.3s ease;
            margin-top: 1rem;
        }

            .btn-custom:hover {
                background-color: #0056b3;
            }

        .highlight-text {
            color: #007bff;
            font-weight: bold;
        }

            .highlight-text:hover {
                color: #0056b3;
                text-decoration: none;
            }

        .text-danger {
            font-size: 0.875rem;
        }

        .text-center {
            color: #0056b3;
        }
    </style>
</head>
<body>
    <div class="register-container">
        <!-- Left Panel -->
        <div class="left-panel text-center">
            <div class="find-your">
                <img class="logo" src="~/photo/845789e0-a99a-48a2-af47-6b0b167b497b.jpeg" alt="Logo" />
                <p class="logo-text">Student Register</p>
            </div>
@*             <footer class="footer">
                <p>&copy; Transpo.Jo. All Rights Reserved 2025</p>
                <p>|</p>
                <p><a href="#">Terms & Conditions</a></p>
            </footer> *@
        </div>

        <!-- Right Panel -->
        <div class="right-panel">
            <form asp-action="Register" asp-controller="Student" method="post" class="register-form" novalidate>
                <h3 class="text-center mb-4">Create an Student Account</h3>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">User Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Enter your name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm your password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input  class="form-check-input" type="checkbox" id="acceptTerms" required />
                    <label for="acceptTerms" class="form-check-label">I agree and accept the <a href="#">terms and conditions</a></label>
                    <div class="invalid-feedback">You must agree before submitting.</div>
                </div>

                <button type="submit" class="btn btn-custom">Create Account</button>

                <p class="text-center mt-3">Already have an account? <a asp-action="LogIn" asp-controller="Student" class="highlight-text">Log in</a></p>
                <p class="text-center mt-3">Home Page? <a asp-action="Home" asp-controller="Index" class="highlight-text">Return</a></p>

            </form>
        </div>
    </div>
</body>
</html>

                                    