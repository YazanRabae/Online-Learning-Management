 @model LMS.Service.DTOs.Courses.StudentCoursesDto
@{
    ViewBag.Title = "Available Courses";
}
<link href="~/css/views/student/enroll.css" rel="stylesheet" />
<script src="~/js/views/student/enroll.js"></script>

<div class="container mt-4">
    <!-- Alert Messages -->
    <div id="failEnrollAlert" class="alert alert-danger d-none" role="alert">
        Failed to enroll!
    </div>
    <div id="successEnrollAlert" class="alert alert-success d-none" role="alert">
        Successfully enrolled!
    </div>

    <!-- Search Filters -->
    <div class="row mb-4">
        <div class="col-md-3">
            <input type="text" id="searchTitle" class="form-control" placeholder="Search by Title" />
        </div>
        <div class="col-md-3">
            <input type="text" id="searchInstructor" class="form-control" placeholder="Search by Instructor" />
        </div>
        <div class="col-md-3">
            <input type="number" id="searchPrice" class="form-control" placeholder="Search by Price" />
        </div>
        <div class="col-md-3">
            <button id="btnSearch" class="btn btn-primary w-100">Search</button>
            <button id="btnReset" class="btn btn-secondary w-100 mt-2">Reset</button>
        </div>
    </div>

    <!-- Courses List -->
    <h2 class="mb-4">Available Courses</h2>
    <div class="row" id="availableCoursesContainer">
        @if (Model.AvailableCourses != null && Model.AvailableCourses.Any())
        {
            foreach (var course in Model.AvailableCourses)
            {
                <div class="col-lg-4 col-md-6 mb-4 course-card" data-title="@course.Title" data-instructor="@course.InstructorName" data-price="@course.Price">
                    <div class="card shadow-sm border-0 rounded">
                        <img src="data:image/jpeg;base64,@course.ImageData" class="card-img-top" alt="@course.Title" />
                        <div class="card-body">
                            <h5 class="card-title">@course.Title</h5>
                            <p class="card-text">@course.Description</p>
                            <p class="card-text"><strong>Instructor:</strong> @course.InstructorName</p>
                            <p class="card-text"><strong>Price:</strong> @course.Price JD</p>
                            <p class="card-text"><strong>Start:</strong> @course.StartDate.ToShortDateString()</p>
                            <div class="d-flex justify-content-center">
                                <button class="btn btn-primary enroll-btn" data-course-id="@course.Id">Enroll</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted ms-3">No courses available to enroll.</p>
        }
    </div>
</div>
